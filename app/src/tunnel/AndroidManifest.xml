<?xml version="1.0" encoding="utf-8"?>
<!-- tunnel flavor only. The offline (default) flavor never gets these. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to forward allowed DNS lookups to the current network's resolvers.
         Nothing else in the app opens sockets (enforced by NoNetworkOutsideTunnelTest). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- App list for per-app rules: launcher apps only (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <activity
            android:name="com.example.moneymanager.tunnel.ui.TunnelActivity"
            android:exported="false"
            android:label="@string/tunnel_title"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MoneyManager" />

        <!-- Bound by the system only (BIND_VPN_SERVICE). Not a foreground service:
             an established VPN keeps foreground priority on its own. -->
        <service
            android:name="com.example.moneymanager.tunnel.TunnelVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <service
            android:name="com.example.moneymanager.tunnel.TunnelTileService"
            android:exported="true"
            android:icon="@drawable/ic_tunnel"
            android:label="@string/tunnel_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name="com.example.moneymanager.tunnel.TunnelActionReceiver"
            android:exported="false" />
    </application>
</manifest>
