<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Currency Symbol"
            android:textColor="?android:textColorSecondary" />
        <EditText
            android:id="@+id/et_currency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date Format"
            android:textColor="?android:textColorSecondary" />
        <EditText
            android:id="@+id/et_date_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <Switch
            android:id="@+id/switch_sample_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Sample Data on Empty DB"
            android:layout_marginBottom="16dp" />

        <Switch
            android:id="@+id/switch_auto_import_sms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_auto_import_sms"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_auto_import_sms_hint"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings" />
            
    </LinearLayout>

</FrameLayout>
