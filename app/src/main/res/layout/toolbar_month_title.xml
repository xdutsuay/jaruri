<?xml version="1.0" encoding="utf-8"?>
<!-- Centered month title for the toolbar (matches old Money Manager). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar_month_root"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingHorizontal="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_toolbar_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/toolbar_on_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Sept" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_chevron_down"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:tint="@color/toolbar_on_primary" />
</LinearLayout>
