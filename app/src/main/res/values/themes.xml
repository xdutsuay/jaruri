<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MoneyManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_yellow</item>
        <item name="colorPrimaryVariant">@color/primary_yellow_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/primary_yellow_dark</item>
        <item name="android:navigationBarColor">@color/background_gray</item>
        <item name="android:windowBackground">@color/background_gray</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.Jaruri.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.Jaruri.Button.Text</item>
        <item name="dividerHorizontal">@color/hairline</item>
        <item name="dividerVertical">@color/hairline</item>
    </style>

    <style name="Theme.MoneyManager" parent="Base.Theme.MoneyManager" />

    <!-- Force a light, high-contrast dialog regardless of system night mode. -->
    <style name="ThemeOverlay.Jaruri.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface_white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Jaruri.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Jaruri.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Jaruri.DialogButton</item>
    </style>

    <style name="TextAppearance.Jaruri.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Jaruri.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Jaruri.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="Widget.Jaruri.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Jaruri.FilterButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/filter_chip_height</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/filter_button_text</item>
        <item name="backgroundTint">@color/filter_button_bg</item>
        <item name="strokeColor">@color/filter_button_stroke</item>
        <item name="strokeWidth">@dimen/hairline_stroke</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Ledger / summary cards: flat fill, visible hairline stroke -->
    <style name="Widget.Jaruri.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/hairline_thin</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>
</resources>
