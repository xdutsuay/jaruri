<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_login">

    <fragment
        android:id="@+id/nav_login"
        android:name="com.example.moneymanager.ui.LoginFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.moneymanager.ui.HomeFragment"
        android:label="Money Manager"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_addTransaction"
            app:destination="@id/addTransactionFragment" />
        <action
            android:id="@+id/action_home_to_importSms"
            app:destination="@id/nav_import_sms" />
        <action
            android:id="@+id/action_home_to_chart"
            app:destination="@id/nav_chart" />
    </fragment>

    <fragment
        android:id="@+id/nav_chart"
        android:name="com.example.moneymanager.ui.ChartFragment"
        android:label="Chart"
        tools:layout="@layout/fragment_chart" />

    <fragment
        android:id="@+id/nav_categories"
        android:name="com.example.moneymanager.ui.CategoriesFragment"
        android:label="Categories" />

    <fragment
        android:id="@+id/nav_export"
        android:name="com.example.moneymanager.ui.ExportFragment"
        android:label="Export"
        tools:layout="@layout/fragment_export" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.moneymanager.ui.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/addTransactionFragment"
        android:name="com.example.moneymanager.ui.AddTransactionFragment"
        android:label="Add Transaction"
        tools:layout="@layout/fragment_add_transaction">
        <action
            android:id="@+id/action_addTransaction_to_importSms"
            app:destination="@id/nav_import_sms" />
    </fragment>

    <fragment
        android:id="@+id/nav_import_sms"
        android:name="com.example.moneymanager.ui.ImportSmsFragment"
        android:label="@string/import_sms_title"
        tools:layout="@layout/fragment_import_sms" />
</navigation>
