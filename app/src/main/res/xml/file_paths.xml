<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Listener: play/share chunks from app-private storage. -->
    <files-path name="listener" path="listener/" />
    <!-- Listener v2: transcript exports handed to the share sheet. -->
    <cache-path name="exports" path="exports/" />
    <!-- CSV export on Android 9 and below writes to public Downloads only. -->
    <external-path name="downloads" path="Download/" />
</paths>
