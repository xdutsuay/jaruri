<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Listener: manual meeting recorder runs as a microphone foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Listener v2: long on-device transcription runs as a WorkManager foreground job. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Tunnel only: forward allowed DNS lookups to the current network's resolvers.
         Nothing outside the tunnel package opens sockets (enforced by NoNetworkOutsideTunnelTest). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tunnel only: find the current non-VPN network and its DNS servers (normal permission). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Tunnel per-app rules: launcher apps only (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Special access: user grants via Settings → Usage access (AppOps OPSTR_GET_USAGE_STATS). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoneyManager"
        tools:targetApi="31">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MoneyManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Not BROWSABLE: web pages must not be able to write ledger rows. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="jaruri"
                    android:host="add" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.moneymanager.action.QUICK_ADD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".sms.SmsTransactionReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.SummaryWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/summary_widget_info" />
        </receiver>

        <!-- Quick expense sheet. Exported only so Routines/Tasker/back-tap can open it;
             it never saves without the user tapping Save. Not shown over the lock screen. -->
        <activity
            android:name=".quickadd.QuickExpenseActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/quick_expense_title"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Jaruri.QuickExpense"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="com.kaustubhtripathi.jaruri.action.QUICK_EXPENSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".quickadd.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_add"
            android:label="@string/money_tile_quick_add"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Listener: started only by an explicit user action; no boot receiver. -->
        <service
            android:name=".listener.ListenerService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".listener.ListenerTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/listener_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- "Cancel" on the transcription notification (explicit intent only). -->
        <receiver
            android:name=".listener.transcribe.TranscriptionCancelReceiver"
            android:exported="false" />

        <activity
            android:name=".tunnel.ui.TunnelActivity"
            android:exported="false"
            android:label="@string/tunnel_title"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MoneyManager" />

        <!-- Bound by the system only (BIND_VPN_SERVICE). Not a foreground service:
             an established VPN keeps foreground priority on its own. -->
        <service
            android:name=".tunnel.TunnelVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <service
            android:name=".tunnel.TunnelTileService"
            android:exported="true"
            android:icon="@drawable/ic_tunnel"
            android:label="@string/tunnel_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".tunnel.TunnelActionReceiver"
            android:exported="false" />

        <!-- WorkManager's foreground service needs a declared type on Android 14+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
